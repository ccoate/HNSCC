                          "PTMA", "RPS2", "RPL5", "RPS4X", "TUBB", "MIR205HG", "TUBA1B", "RPL17", "RPL22", 
                          "HNRNPA2B1", "COL1A2", "IFITM3", "NME2", "MT2A", "COL1A1")

core_marker_df <- subset(OSCC_markers, OSCC_markers$gene %in% tumor_core_markers)
