# Identifying Tumor Core and Comparing to Healthy Sample post-integration

library(ggplot2)
library(ggrepel)
library(dplyr)
library(magrittr)
library(patchwork)

merged <- readRDS("/Users/chandlercoate/Downloads/GSE220978_OSCC_GSE206621_Healthy_integrate_seed_1.rds")

merged@meta.data <- merged@meta.data %>%
  mutate(diagnosis = case_when(
    grepl("Healthy", sample_id) ~ "Healthy",
    grepl("OSCC", sample_id) ~ "OSCC"
  ))

Idents(merged) <- "diagnosis"  # Set your new column as active identity

table(merged$diagnosis)

DefaultAssay(merged) <- "integrated"

merged_OSCC <- subset(merged, subset = diagnosis == "OSCC")

merged_OSCC <- RunPCA(merged_OSCC, dims = 1:75)
merged_OSCC <- FindNeighbors(merged_OSCC, dims = 1:50, k.param = 20, verbose = TRUE)
merged_OSCC <- FindClusters(merged_OSCC, resolution = 0.4, algorithm = 4, verbose = FALSE, graph.name = "integrated_snn", random.seed = 1)
merged_OSCC <- RunUMAP(merged_OSCC, dims = 1:50, verbose = FALSE)

table(merged_OSCC$seurat_clusters)

OSCC_markers <- FindAllMarkers(merged_OSCC, assay = "integrated")

hnscc_markers <- c("CDH3", "COL17A1", "PLEK2", "SLC7A5", "PVRL1", "SDC1", "SLC2A1", 
                   "ULBP2", "DSG3", "CLCA2", "IGSF3", "LY6K", "CDCP1", "GJB2", "LY6D",   
                   "LGALS1", "LGALS3", "CLDN4", "TACSTD2", "CD276", "SIRPA", "NECTIN4")
valid_genes <- hnscc_markers[hnscc_markers %in% rownames(merged_OSCC[["integrated"]]@data)]

DoHeatmap(
  merged_OSCC,
