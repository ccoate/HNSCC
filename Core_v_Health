clust6_merged <- subset(merged_OSCC, subset = seurat_clusters == "6")
clust6_merged$identity <- "core"
merged_health <- subset(merged, subset = diagnosis == "Healthy")
merged_health$identity <- "Healthy"

core_v_health <- merge(clust6_merged, merged_health)
table(core_v_health$identity)

Idents(core_v_health) <- "identity"

cvh_markers <- FindMarkers(core_v_health, ident.1 = "core", ident.2 = "Healthy", assay = "integrated")
cvh_markers$gene <- rownames(cvh_markers)

# Plots ####
cvh_hnscc_subset <- subset(cvh_markers, cvh_markers$gene %in% hnscc_markers)

# Volcano plot
# build your volcano data frame first:
vol <- cvh_hnscc_subset %>%
  mutate(
    sig = case_when(
      p_val_adj < 0.05 & avg_log2FC >  1  ~ "Up",
      p_val_adj < 0.05 & avg_log2FC < -1  ~ "Down",
      TRUE                                ~ "NS"
    )
  )

p_vol <- ggplot(vol, aes(x = avg_log2FC, y = -log10(p_val_adj), colour = sig)) +
  geom_point(alpha = 0.6) +
  scale_colour_manual(
    values = c(Up = "firebrick", Down = "steelblue", NS = "gray70")
  ) +
  geom_vline(xintercept = c(-1,1), linetype = "dashed") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
  theme_minimal(base_size = 14) +
  labs(
    x = expression(Log[2]~fold~change),
    y = expression(-Log[10]~adjusted~P),
    colour = NULL
  )

to_label_vol <- vol %>%
  #filter(p_val_adj < 0.05, abs(avg_log2FC) > 1) %>%
  group_by(gene) %>%
  #slice_max(order_by = abs(avg_log2FC), n = 1) %>%
  ungroup()

p_vol + 
  geom_text_repel(
    data = to_label_vol,
    aes(label = gene),
    size        = 3,
    box.padding = 0.3,
    max.overlaps = 20
  )

save(p_vol, file = "./vol_ma_6.27.25/vol_June_27.RData")

# MA plot

# 3) MA plot
# here we approximate average expression by (pct.1 + pct.2)/2
# make sure you have 'A' and 'M' and 'sig' in your data:
ma_df <- cvh_hnscc_subset %>%
  mutate(
    A   = log2(((pct.1 + pct.2)/2) + 1),
    M   = avg_log2FC,
    sig = case_when(
      p_val_adj < 0.05 & avg_log2FC >  1  ~ "Up",
      p_val_adj < 0.05 & avg_log2FC < -1  ~ "Down",
      TRUE                                ~ "NS"
    )
  )

p_ma <- ggplot(ma_df, aes(x = A, y = M, colour = sig)) +
  geom_point(alpha = 0.6) +
  scale_colour_manual(
    values = c(Up = "firebrick", Down = "steelblue", NS = "gray70")
  ) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  theme_minimal(base_size = 14) +
  labs(
    x = expression(Log[2]~mean~expression),
    y = expression(Average~Log[2]~fold~change),
    colour = NULL
  )

# pick points to label—e.g. only the significant ones
to_label_ma <- ma_df %>%
  #filter(p_val_adj < 0.05, abs(M) > 1) %>%
  group_by(gene) %>%
  #slice_max(order_by = abs(M), n = 1) %>%
  ungroup()

p_ma +
  geom_text_repel(
    data = to_label_ma,
    aes(label = gene),
    size        = 3,
    box.padding = 0.3,
    max.overlaps = 20
  )

save(p_ma, file = "./vol_ma_6.27.25/ma_June_27.RData")


